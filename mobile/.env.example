# Sao chep file nay thanh ".env" (cung cap) truoc khi chay app - "expo start" tu dong doc file
# ".env" va nhung cac bien bat dau bang "EXPO_PUBLIC_" vao process.env luc build (khong can them
# thu vien nao). Xem giai thich chi tiet trong README.md.

# ─── Backend API ──────────────────────────────────────────────────────────────
# URL goc cua backend Express. CHI CAN dat khi test tren THIET BI THAT (dien thoai that, cung
# mang Wifi voi may chay backend) hoac khi build ban production. Neu bo trong luc dev tren
# may ao (emulator/simulator), app se tu dung gia tri mac dinh phu hop tung nen tang
# (xem src/config/env.ts) - KHONG can dat bien nay.
# Vi du (thiet bi that, may chay backend co IP LAN la 192.168.1.5):
# EXPO_PUBLIC_API_URL=http://192.168.1.5:4000

# ─── Google Sign-In (bat buoc de nut "Dang nhap bang Google" hoat dong) ───────
# Lay tu Firebase Console > Project Settings > (thay doi/them) Google Sign-In provider, hoac truc
# tiep tu Google Cloud Console > APIs & Services > Credentials.
# "Web client ID" - BAT BUOC (dung de lay duoc idToken, ke ca tren Android/iOS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# "iOS client ID" - CHI can neu build cho iOS (co the de trong khi con dang phat trien Android).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
